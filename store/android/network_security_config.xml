<?xml version="1.0" encoding="utf-8"?>
<!-- Template for the native Android shell. Do not point this at a fake domain. -->
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
